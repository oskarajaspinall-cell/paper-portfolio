#!/bin/bash
# Weekdays ~10:30 New York (launchd: ~/Library/LaunchAgents/com.paperportfolio.entry-intraday.plist fires at
# 14:30 and 15:30 UK time; the script acts only inside [entry].intraday_window_et). Live prices vs entry
# prices for US watch stocks; any hit is re-researched at once (never bought on price alone). Commit, upload.
set -u
# Keep the Mac awake for the whole job (2026-10-19: the 21:30 run paused for 30 minutes when the Mac slept). -i stops
# idle sleep, -s system sleep while on mains power; closing the lid on battery still forces sleep.
[ -z "${PP_CAFFEINATED:-}" ] && exec env PP_CAFFEINATED=1 /usr/bin/caffeinate -i -s "$0" "$@"
cd "$(dirname "$0")/.." || exit 1
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p logs
LOG="logs/entry-intraday-$(date +%F).log"
exec >>"$LOG" 2>&1
echo "== start $(date)"
if [ -e /tmp/paper-portfolio-review.lock ]; then echo "weekly review or fills running; skipping"; exit 0; fi
# The Mac may have just woken (2026-10-15/16: every live price failed on DNS): wait up to 10 min for the network
online() { bin/py -c "import socket; socket.create_connection(('query1.finance.yahoo.com', 443), timeout=10).close()" 2>/dev/null; }
for i in $(seq 1 20); do online && break; sleep 30; done
online || { echo "!! offline after 10 minutes: no intraday check this run"; exit 0; }
out=$(bin/with-timeout 600 bin/py scripts/entry_watch.py intraday) || { echo "!! intraday check failed"; echo "$out"; exit 1; }
echo "$out"
# dip-radar hits from last night (scripts/dip_radar.py) are researched in the same window as intraday hits
dips=$(bin/py -c "import json; print(len(json.load(open('portfolio/state.json')).get('dip_hits') or []))")
case "$out" in *'"skipped"'*) echo "== end $(date)"; exit 0;; esac
case "$out" in *'"hits": []'*) [ "$dips" = "0" ] && { echo "== end $(date)"; exit 0; };; esac
caffeinate -i bin/with-timeout 7200 bin/py scripts/entry_research.py || echo "!! re-research failed"
bin/with-timeout 600 bin/py scripts/dashboard.py >/dev/null || echo "!! dashboard not updated"
git add -A -- portfolio docs reports/entry-watch "runs/$(date +%F)-entry" "$LOG"
for f in runs/"$(date +%F)"-entry/done-*; do [ -e "$f" ] && git add -A -- "research/${f##*/done-}"; done  # only re-researched stocks
git commit -q -m "Intraday entry-price / dip-radar check $(date +%F): hits re-researched" && git pull -q --rebase --autostash && git push -q && echo "uploaded to GitHub" || echo "!! upload failed (committed locally)"
echo "== end $(date)"
