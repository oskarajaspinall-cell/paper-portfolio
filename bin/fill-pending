#!/bin/bash
# Weekdays 22:30 (launchd: ~/Library/LaunchAgents/com.paperportfolio.fills.plist): fill pending orders
# at their next open, re-price every holding at its latest close (daily valuation), refresh the dashboard,
# commit and upload if anything changed. No AI.
set -u
cd "$(dirname "$0")/.." || exit 1
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p logs
LOG="logs/fills-$(date +%F).log"
exec >>"$LOG" 2>&1
echo "== start $(date)"
LOCK=/tmp/paper-portfolio-review.lock      # same lock as the weekly review: never runs alongside it
if ! mkdir "$LOCK" 2>/dev/null; then echo "weekly review running; skipping"; exit 0; fi
trap 'rmdir "$LOCK"' EXIT
ASOF=$(date -v+1d +%F)                     # include today's session (all markets have opened by 22:30)
python_out=$(bin/with-timeout 900 bin/py scripts/portfolio.py fill-pending --asof "$ASOF") || { echo "!! fill-pending failed"; echo "$python_out"; exit 1; }
echo "$python_out"
# Dividends and splits (no AI, owner request 2026-10-16) BEFORE re-pricing: a split not applied would re-price
# the old share count at the new price, so a failure here stops the run.
bin/with-timeout 1200 bin/py scripts/corporate_actions.py check --asof "$ASOF" || { echo "!! dividends/splits check failed: not re-pricing"; exit 1; }
# Daily re-pricing (no AI): every holding at its latest close, a valuation point, a fresh dashboard.
bin/with-timeout 900 bin/py scripts/portfolio.py mark --phase daily --asof "$ASOF" || { echo "!! daily re-pricing failed"; exit 1; }
# Entry prices (no AI): a conviction-3+ name closing at/below its entry price is re-researched first next run
bin/with-timeout 900 bin/py scripts/entry_watch.py check --asof "$ASOF" || echo "!! entry watch not updated"
# Daily dip check (no AI, 2026-10-19): the S&P 500's distance below its 52-week high resets the dip release on the
# weekly regime's reserve, so a sell-off frees the reserve for tomorrow's open (the funding queue below can use it)
bin/with-timeout 300 bin/py scripts/regime.py --dip --asof "$ASOF" || echo "!! dip check failed (the last reserve stands)"
# Funding queue (no AI, 2026-10-18): a conviction-4 BUY stopped only by the cash reserve is resubmitted for the
# next open once there is room above the reserve (best upside first); stale ideas drop out
bin/with-timeout 600 bin/py scripts/funding_queue.py review --asof "$ASOF" || echo "!! funding queue not reviewed"
if git diff --quiet -- portfolio; then echo "nothing changed"; exit 0; fi
bin/with-timeout 600 bin/py scripts/dashboard.py >/dev/null || echo "!! dashboard not updated"
git add -A -- portfolio docs reports/entry-watch reports/regime "$LOG"
git commit -q -m "Daily update $(date +%F)" && git pull -q --rebase --autostash && git push -q && echo "uploaded to GitHub" || echo "!! upload failed (committed locally)"
echo "== end $(date)"
