#!/bin/bash
# Weekdays 22:30 (launchd: ~/Library/LaunchAgents/com.paperportfolio.fills.plist): fill pending orders
# at their next open, re-price every holding at its latest close (daily valuation), refresh the dashboard,
# commit and upload if anything changed. No AI.
set -u
cd "$(dirname "$0")/.." || exit 1
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p logs
LOG="logs/fills-$(date +%F).log"
exec >>"$LOG" 2>&1
echo "== start $(date)"
LOCK=/tmp/paper-portfolio-review.lock      # same lock as the weekly review: never runs alongside it
if ! mkdir "$LOCK" 2>/dev/null; then echo "weekly review running; skipping"; exit 0; fi
trap 'rmdir "$LOCK"' EXIT
ASOF=$(date -v+1d +%F)                     # include today's session (all markets have opened by 22:30)
python_out=$(bin/py scripts/portfolio.py fill-pending --asof "$ASOF") || { echo "!! fill-pending failed"; echo "$python_out"; exit 1; }
echo "$python_out"
# Daily re-pricing (no AI): every holding at its latest close, a valuation point, a fresh dashboard.
bin/py scripts/portfolio.py mark --phase daily --asof "$ASOF" || { echo "!! daily re-pricing failed"; exit 1; }
if git diff --quiet -- portfolio; then echo "nothing changed"; exit 0; fi
bin/py scripts/dashboard.py >/dev/null || echo "!! dashboard not updated"
git add -A -- portfolio docs "$LOG"
git commit -q -m "Daily update $(date +%F)" && git pull -q --rebase --autostash && git push -q && echo "uploaded to GitHub" || echo "!! upload failed (committed locally)"
echo "== end $(date)"
