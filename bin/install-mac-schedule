#!/bin/bash
# Schedule the portfolio on this Mac with macOS's built-in scheduler (launchd):
#   Friday 22:00   bin/weekly-local   screen + weekly review, commit, upload
#   Weekdays 22:30 bin/fill-pending   fill pending orders at the next open, commit, upload
#   Weekdays 14:30 + 15:30 bin/entry-intraday   ~10:30 New York: live prices vs entry prices (acts only in the
#                  New York window, so exactly one of the two runs across the UK/US clock-change weeks)
#   Every 15 min   bin/live-dashboard  weekdays 08:00-21:15 UK: dashboard with live prices, upload if changed
# The Mac must be on (if asleep, launchd runs the job on wake). Usage:
#   bin/install-mac-schedule            install / refresh all jobs
#   bin/install-mac-schedule --remove   remove all jobs
set -eu
DIR="$(cd "$(dirname "$0")/.." && pwd)"
AGENTS="$HOME/Library/LaunchAgents"
UIDN="$(id -u)"

plist() { # label script calendar-xml
  cat <<XML
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$1</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$DIR/bin/$2</string></array>
  <key>WorkingDirectory</key><string>$DIR</string>
  <key>StartCalendarInterval</key>
$3
  <key>StandardOutPath</key><string>$DIR/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>$DIR/logs/launchd.log</string>
</dict>
</plist>
XML
}

JOBS="com.paperportfolio.weekly com.paperportfolio.fills com.paperportfolio.entry-intraday com.paperportfolio.live-dashboard"
# Unloading a job kills its running processes: never reinstall while one is mid-run (e.g. the Friday weekly run).
for label in $JOBS; do
  pid=$(launchctl list | awk -v l="$label" '$3 == l {print $1}')
  if [ -n "$pid" ] && [ "$pid" != "-" ]; then
    echo "$label is running (pid $pid); not touching the schedule. Try again when it has finished."; exit 1
  fi
done
for label in $JOBS; do
  launchctl bootout "gui/$UIDN/$label" 2>/dev/null || true
done
if [ "${1:-}" = "--remove" ]; then
  for label in $JOBS; do rm -f "$AGENTS/$label.plist"; done
  echo "Removed all scheduled jobs."
  exit 0
fi

mkdir -p "$AGENTS" "$DIR/logs"
plist com.paperportfolio.weekly weekly-local \
  "  <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>" \
  > "$AGENTS/com.paperportfolio.weekly.plist"
days=""
for d in 1 2 3 4 5; do days="$days    <dict><key>Weekday</key><integer>$d</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
"; done
plist com.paperportfolio.fills fill-pending "  <array>
$days  </array>" > "$AGENTS/com.paperportfolio.fills.plist"

days=""
for d in 1 2 3 4 5; do for h in 14 15; do days="$days    <dict><key>Weekday</key><integer>$d</integer><key>Hour</key><integer>$h</integer><key>Minute</key><integer>30</integer></dict>
"; done; done
plist com.paperportfolio.entry-intraday entry-intraday "  <array>
$days  </array>" > "$AGENTS/com.paperportfolio.entry-intraday.plist"

plist com.paperportfolio.live-dashboard live-dashboard "  <integer>900</integer>" \
  | sed 's|<key>StartCalendarInterval</key>|<key>StartInterval</key>|' > "$AGENTS/com.paperportfolio.live-dashboard.plist"

for label in $JOBS; do
  plutil -lint -s "$AGENTS/$label.plist"
  launchctl bootstrap "gui/$UIDN" "$AGENTS/$label.plist"
done
echo "Scheduled: Friday 22:00 weekly run; weekdays 22:30 order fills; weekdays ~10:30 New York intraday entry check; live dashboard every 15 min in market hours. Logs in $DIR/logs/."
